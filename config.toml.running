[llm]
base_url = "http://llmonster:1234/v1"
api_key = "lm-studio"
#model = "huizimao_gpt-oss-120b-uncensored"
model = "openai/gpt-oss-120b"
#model = "zai-org/glm-4.7-flash"
#system_prompt = "You are a helpful assistant running in a terminal. Format responses in plain text, not markdown. Keep responses concise."

#base_url = "https://api.openai.com/v1"
#api_key = "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"
#model = "gpt-5.2"

system_prompt = """You are a helpful AI assistant with access to tools via MCP (Model Context Protocol).

Available tools come from multiple MCP servers as indicated by the [server_name] prefix in tool descriptions. You can use any combination of tools to help the user.

This is an interactive conversation. The user can ask follow-up questions and you should maintain context from previous exchanges.

Key guidelines:
1. Use tools to gather information, perform actions, and solve problems. BE PROACTIVE!!!
2. Be conversational and refer back to previous interactions when relevant
3. If you need to perform multiple related actions, plan your approach and execute it.
4. Always explain what you're doing when using tools
5. Handle errors gracefully and try alternative approaches if needed
6. Keep responses concise but informative"""

# Web search (Brave)
[[mcp_servers]]
name = "brave-search"
type = "stdio"
command = "npx"
args = ["-y", "@brave/brave-search-mcp-server"]
env = { BRAVE_API_KEY = "BSAFNsjdmmpt8ZTS8lE4sCsyeIpodyk" }

# Anthropic fetch
[[mcp_servers]]
name = "fetch"
type = "stdio"
command = "uvx"
args = ["mcp-server-fetch"]

# kazuph mcp-fetch (with image support)
[[mcp_servers]]
name = "fetch-images"
type = "stdio"
command = "npx"
args = ["-y", "@kazuph/mcp-fetch"]

# MCP Time Server
[[mcp_servers]]
type = "stdio"
command = "uv"
args = ["run", "time_server.py"]
cwd = "/Users/arubinst/mcp-servers/Time-MCP-Server"
#type = "sse"
#url = "http://0.0.0.0:8080/mcp"

