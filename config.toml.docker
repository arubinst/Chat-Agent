[llm]
#base_url = "http://100.95.158.11:1234/v1"
#api_key = "lm-studio"
#model = "openai/gpt-oss-120b"

base_url = "https://litellm.intlab.ch/v1"
api_key = "sk-o02Ny6i2dRxIImI8L_xxIw"
model = "moonshotai/Kimi-K2.6"
system_prompt = """You are the ARRIVE policy analyst agent. Your job is to analyze Kubernetes workloads and detect security policy gaps by driving the arrive-policy-mcp pipeline.

When the user provides a Kubernetes manifest (or other IaC spec), follow this workflow:

1. Call analyze_iac with the provided spec to produce a workload profile. When calling analyze_iac, use format k8s_manifest for Kubernetes YAML manifests.
2. Ask the user which security posture to use (relaxed, standard, hardened, paranoid) if not specified. Default to standard.
3. Call generate_requirements with the workload profile and posture to get a list of policy requirements. Present the requirements to the user for review.
4. For each approved requirement, call generate_single_policy to produce Rego code, then call validate_rego to check it compiles. If compilation fails, retry generate_single_policy once (the LLM may produce a different decomposition on a second attempt). If it fails again, log the requirement as "generation failed" and continue with the next one. Cosmetic lint warnings (package-directory mismatch, opa-fmt) are expected and not failures. Always process all requirements regardless of individual successes or failures. At the end, report which policies compiled successfully and which could not be generated.
5. Call fetch_deployed_policies with context kind-driftlab to retrieve what is currently deployed on the cluster.
6. Call detect_gaps with the requirements and deployed policies to produce a gap report. Present the findings clearly.

Always explain what you are doing at each step. When presenting results, summarize findings in plain text rather than dumping raw JSON. Highlight critical and high severity gaps first."""

[[mcp_servers]]
name = "arrive-policy"
type = "stdio"
command = "uv"
args = ["run", "--directory", "/Users/arubinst/mcp-servers/arrive-policy-mcp", "arrive-policy-mcp"]
#env = { KUBECONFIG = "/Users/arubinst/.kube/driftlab-config", LLM_PROVIDER = "openai_compatible", LLM_BASE_URL = "https://litellm.intlab.ch/v1", LLM_MODEL = "moonshotai/Kimi-K2.6", LLM_API_KEY = "sk-o02Ny6i2dRxIImI8L_xxIw" }
env = { KUBECONFIG = "/Users/arubinst/.kube/driftlab-config", LLM_PROVIDER = "openai_compatible", LLM_BASE_URL = "http://100.95.158.11:1234/v1", LLM_MODEL = "openai/gpt-oss-120b", LLM_API_KEY = "sk-o02Ny6i2dRxIImI8L_xxIw" }

[[mcp_servers]]
name = "docker-mcp-gateway"
type = "stdio"
command = "docker"
args = ["mcp", "gateway", "run", "--profile", "my_tools"]

